# Kopieren Sie diese Datei nach .env und passen Sie die Werte an.
# Zum Laden: export $(cat .env | xargs) oder python-dotenv verwenden.

# Flask Secret Key (wird beim ersten Start automatisch generiert, hier überschreibbar)
SECRET_KEY=ihr-geheimer-schluessel-hier

# Admin-Zugangsdaten beim ersten Start (danach im Admin-Panel änderbar)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=sicheres-passwort

# Datenbank (Standard: SQLite in ./instance/formapp.db)
# DATABASE_URL=postgresql://user:password@localhost/formapp

# Server
HOST=0.0.0.0
PORT=5000
FLASK_DEBUG=false

# Basis-URL für Links in E-Mails (Abstimmungsunterlagen).
# Ohne diesen Wert wird die URL aus dem eingehenden Request abgeleitet, was
# hinter einem Reverse Proxy falsch sein kann.
BASE_URL=https://abstimmung.ihre-domain.tld

# Auf true setzen, sobald die Anwendung über HTTPS läuft (dringend empfohlen –
# die Zugangscodes der Abstimmung stehen in der URL).
SESSION_COOKIE_SECURE=false
